{"announcement": {"headline": "Now more than ever, the restaurant industry needs your help.", "subheadline": "We have never seen anything like this before. The National Restaurant Association estimates that the COVID-19 pandemic will result in $225B in lost revenue and the elimination of 5-7 million jobs in restaurants. Please support the restaurants you love.", "external_links": [{"link_category": "other", "link_label": "Gift Cards", "link": "https://onelink.quickgifts.com/merchant/marker-32-jacksonville/"}, {"link_category": "online_ordering", "link_label": "Pick-up", "link": "https://marker32.com/"}]}, "reopen": {"date": "2020-05-04"}, "custom_affiliations": [], "collections": [{"id": 890, "type_id": 4, "file_name": "new", "image": "https://s3.amazonaws.com/resy.com/images/lists/new.svg", "name": "New on Resy", "short_name": "New on Resy", "description": "Lucky for you, these restaurants are brand-New on Resy. We've sorted them by popularity because if you know, you know.", "collection_slug": "new-on-resy"}, {"id": 891, "type_id": 5, "file_name": "toprated", "image": "https://s3.amazonaws.com/resy.com/images/lists/toprated.svg", "name": "Top Rated", "short_name": "Top Rated", "description": "A crowd-sourced stamp of approval. The five-star treatment. Resy's top-rated restaurants according to you, the guests.", "collection_slug": "top-rated"}], "config": {"allow_bypass_payment_method": 1, "allow_multiple_resys": 0, "enable_discovery": 1, "enable_invite": 1, "enable_resypay": 0, "hospitality_included": 0, "experiences": false}, "contact": {"phone_number": "+19042231534", "url": "https://marker32.com/contact/", "menu_url": null}, "content": [{"attribution": null, "body": "", "display": {"type": "text"}, "icon": {"url": "https://s3.amazonaws.com/resy.com/images/icons/heart.svg"}, "locale": {"language": "en-us"}, "name": "why_we_like_it", "title": null}, {"attribution": null, "body": "Welcome to Marker 32, where you can leave the world behind and enjoy the meal of your life with someone you love.", "display": {"type": "text"}, "icon": {"url": "https://s3.amazonaws.com/resy.com/images/icons/quote.svg"}, "locale": {"language": "en-us"}, "name": "tagline", "title": null}, {"attribution": null, "body": null, "display": {"type": "text"}, "icon": {"url": "https://s3.amazonaws.com/resy.com/images/icons/chat.svg"}, "locale": null, "name": "from_the_venue", "title": null}, {"attribution": null, "body": "If you are running late, please call the restaurant at (904)223-1534. We hold the table for a grace period of 15 minutes before offering the reservation to our waitlist.", "display": {"type": "text"}, "icon": {"url": "https://s3.amazonaws.com/resy.com/images/icons/info.svg"}, "locale": {"language": "en-us"}, "name": "need_to_know", "title": "Need to Know"}, {"attribution": null, "body": "Slip away for an unforgettable meal at Marker 32, Jacksonville\u2019s best-kept secret since 1992. Take in a vivid sunset from our second-floor dining room, overlooking the marina on the stunning Intracoastal Waterway, while enjoying a first class dinner made entirely from fresh, locally gathered seafood and produce. Marker 32 offers a five star meal and world class service with the casual atmosphere of your neighborhood bar. We pride ourselves on providing the best service while making you feel right at home.", "display": {"type": "text"}, "icon": {"url": null}, "locale": {"language": "en-us"}, "name": "about", "title": null}, {"attribution": null, "body": null, "display": {"type": "text"}, "icon": {"url": null}, "locale": null, "name": "pickup_description", "title": null}], "id": {"foursquare": "4ba7dafcf964a5203ab939e3", "google": "ChIJFb1blStK5IgR1lRqO310FF0", "resy": 5795, "fb_pixel": null}, "images": ["https://image.resy.com/3/003/2/5795/bbd6658b6a124534e47cb7a2fac62a7e276a6038/jpg/640x360", "https://image.resy.com/3/003/2/5795/d84d09680bd02482684d41f9402fd15f441fa8b3/jpg/640x360", "https://image.resy.com/3/003/2/5795/50bdcc5364bfa5abbca30242ae52916